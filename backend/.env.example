# Copy this file to backend/.env and adjust as needed.

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Below this softmax probability, predictions are marked "is_uncertain": true
CONFIDENCE_THRESHOLD=0.50

# "haar" works out of the box with zero extra downloads. "dnn" is more
# accurate but requires FACE_DNN_PROTO / FACE_DNN_MODEL weight files.
FACE_DETECTOR=haar

# Maximum accepted upload size, in megabytes
MAX_UPLOAD_SIZE_MB=8

# Optional: override where the backend looks for the trained model/labels/metrics
# EMOTIONVISION_MODELS_DIR=../models
